<resources>
    <style name="Theme.Weather" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/weather_accent</item>
        <item name="colorOnPrimary">@color/weather_on_accent</item>
        <item name="colorPrimaryContainer">@color/weather_surface_elevated</item>
        <item name="colorOnPrimaryContainer">@color/weather_text_primary</item>
        <item name="colorSecondary">@color/weather_accent_secondary</item>
        <item name="colorOnSecondary">@color/weather_on_accent</item>
        <item name="colorSecondaryContainer">@color/weather_surface_elevated</item>
        <item name="colorOnSecondaryContainer">@color/weather_text_primary</item>
        <item name="colorTertiary">@color/weather_accent_secondary</item>
        <item name="colorOnTertiary">@color/weather_on_accent</item>
        <item name="colorSurface">@color/weather_surface</item>
        <item name="colorOnSurface">@color/weather_text_primary</item>
        <item name="colorSurfaceVariant">@color/weather_surface_elevated</item>
        <item name="colorOnSurfaceVariant">@color/weather_text_secondary</item>
        <item name="colorOutline">@color/weather_outline</item>
        <item name="colorError">@color/weather_error</item>
        <item name="colorOnError">@color/weather_on_accent</item>
        <item name="android:colorBackground">@color/weather_background</item>
        <item name="android:windowBackground">@color/weather_background</item>
        <item name="android:statusBarColor">@color/weather_background</item>
        <item name="android:navigationBarColor">@color/weather_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">@font/inter_regular</item>
    </style>
</resources>
