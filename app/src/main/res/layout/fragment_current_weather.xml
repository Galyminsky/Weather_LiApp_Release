<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    tools:context=".fragments.CurrentWeatherFragment">

    <ImageView
        android:id="@+id/weatherBackgroundPrimary"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/weatherBackgroundSecondary"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/weatherBackgroundScrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#33000000"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/weatherDetailsScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:fillViewport="false"
        android:overScrollMode="ifContentScrolls"
        android:paddingStart="@dimen/weather_content_horizontal"
        android:paddingTop="@dimen/weather_space_2"
        android:paddingEnd="@dimen/weather_content_horizontal"
        android:paddingBottom="@dimen/weather_space_6"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/searchCityInput"
                    style="@style/Widget.Weather.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint=""
                    app:boxBackgroundColor="@android:color/transparent"
                    app:boxStrokeColor="@color/weather_accent"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Weather.Control"
                    app:startIconDrawable="@drawable/ic_city_search"
                    app:startIconTint="?attr/colorPrimary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/searchCityField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:hint="@string/search_city_hint"
                        android:importantForAutofill="no"
                        android:maxLines="1"
                        android:minHeight="56dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="?attr/colorOnSurfaceVariant"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ibSync"
                    style="@style/Widget.Weather.Button.Tonal"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="@dimen/weather_space_2"
                    android:contentDescription="@string/weather_refresh_accessibility"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_sync_black"
                    app:iconSize="24dp"
                    app:iconTint="?attr/colorPrimary"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:strokeColor="@color/weather_accent_secondary"
                    app:strokeWidth="1.5dp"
                    android:outlineAmbientShadowColor="@color/weather_accent_secondary"
                    android:outlineSpotShadowColor="@color/weather_accent_secondary"
                    android:text="" />
            </LinearLayout>

            <!-- Большая карточка текущей погоды -->
            <com.protonmail.jobforandroid.weather.widgets.NeomorphicCardView
                style="@style/Widget.Weather.Card.Forecast"
                app:neomorphicFaceOpacity="0.25"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/weather_space_2"
                android:layout_marginStart="-4dp"
                android:layout_marginEnd="-4dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Weather.Card"
                app:strokeColor="@color/weather_neon"
                app:strokeWidth="1dp"
                app:neomorphicGlowColor="@color/weather_neon"
                app:neomorphicGlowRadius="4dp">

                <LinearLayout
                    android:id="@+id/weatherHero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/tvCity"
                        style="@style/TextAppearance.Weather.City"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="none"
                        android:gravity="center"
                        android:textSize="24sp"
                        android:lineSpacingExtra="0dp"
                        android:breakStrategy="high_quality"
                        android:text=""
                        tools:text="Санкт-Петербург" />

                    <FrameLayout
                        android:id="@+id/weatherIllustrationFrame"
                        android:layout_width="match_parent"
                        android:layout_height="240dp"
                        android:layout_marginTop="@dimen/weather_space_1"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/weather_image"
                        android:clipChildren="true"
                        android:clipToPadding="true">

                        <WebView
                            android:id="@+id/weatherIllustration"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:overScrollMode="never"
                            android:scrollbars="none" />

                        <ImageView
                            android:id="@+id/imWeather"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:contentDescription="@string/weather_image"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_weather_unknown"
                            app:tint="?attr/colorOnSurfaceVariant"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvCurrentTemp"
                        style="@style/TextAppearance.Weather.Temperature"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/weather_space_1"
                        android:autoSizeMaxTextSize="96sp"
                        android:autoSizeMinTextSize="56sp"
                        android:autoSizeStepGranularity="2sp"
                        android:autoSizeTextType="uniform"
                        android:textSize="96sp"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text=""
                        tools:text="−18°C" />

                    <TextView
                        android:id="@+id/tvCondition"
                        style="@style/TextAppearance.Weather.Condition"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/weather_space_1"
                        android:gravity="center"
                        android:textSize="20sp"
                        android:lineSpacingExtra="0dp"
                        android:ellipsize="none"
                        android:breakStrategy="high_quality"
                        android:text=""
                        tools:text="Небольшой ледяной дождь" />
                </LinearLayout>
            </com.protonmail.jobforandroid.weather.widgets.NeomorphicCardView>

            <com.protonmail.jobforandroid.weather.widgets.NeomorphicCardView
                android:id="@+id/cardTodayTemperatureDetails"
                style="@style/Widget.Weather.Card.Forecast"
                app:neomorphicFaceOpacity="0.25"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/weather_space_2"
                android:layout_marginStart="-4dp"
                android:layout_marginEnd="-4dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Weather.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:id="@+id/tvFeelsLike"
                        style="@style/TextAppearance.Weather.Value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="2"
                        android:text=""
                        tools:text="Ощущается 4°C" />

                    <TextView
                        android:id="@+id/tvMaxMin"
                        style="@style/TextAppearance.Weather.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="2"
                        android:text=""
                        tools:text="Макс. 12°C · Мин. 2°C" />
                </LinearLayout>
            </com.protonmail.jobforandroid.weather.widgets.NeomorphicCardView>

            <TextView
                android:id="@+id/tvData"
                style="@style/TextAppearance.Weather.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/weather_space_2"
                android:gravity="end"
                android:text=""
                tools:text="Обновлено 19:00" />

            <!-- Сетка маленьких карточек погодных показателей -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/weather_space_3"
                android:baselineAligned="false"
                android:clipChildren="false"
                android:orientation="horizontal">

                <!-- Карточка: Скорость ветра -->
                <com.protonmail.jobforandroid.weather.widgets.NeomorphicCardView
                    android:id="@+id/cardWind"
                    style="@style/Widget.Weather.Card.Forecast"
                    app:neomorphicFaceOpacity="0.25"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/weather_space_1"
                    android:layout_marginStart="-4dp"
                    android:layout_weight="1"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Weather.Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:minHeight="125dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:contentDescription="@null"
                            app:tint="?attr/colorPrimary"
                            app:srcCompat="@drawable/ic_weather_wind" />

                        <TextView
                            style="@style/TextAppearance.Weather.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="@string/weather_wind"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/tvWindValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/inter_semibold"
                            android:gravity="center"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="20sp"
                            tools:text="18 км/ч" />

                        <TextView
                            android:id="@+id/tvWindDirection"
                            style="@style/TextAppearance.Weather.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:maxLines="1"
                            tools:text="Северо-запад" />
                    </LinearLayout>
                </com.protonmail.jobforandroid.weather.widgets.NeomorphicCardView>

                <!-- Карточка: Влажность -->
                <com.protonmail.jobforandroid.weather.widgets.NeomorphicCardView
                    android:id="@+id/cardHumidity"
                    style="@style/Widget.Weather.Card.Forecast"
                    app:neomorphicFaceOpacity="0.25"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/weather_space_1"
                    android:layout_marginEnd="-4dp"
                    android:layout_weight="1"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Weather.Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:minHeight="125dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:contentDescription="@null"
                            app:tint="?attr/colorPrimary"
                            app:srcCompat="@drawable/ic_weather_humidity" />

                        <TextView
                            style="@style/TextAppearance.Weather.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="@string/weather_humidity"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/tvHumidityValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/inter_semibold"
                            android:gravity="center"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="22sp"
                            tools:text="68%" />
                    </LinearLayout>
                </com.protonmail.jobforandroid.weather.widgets.NeomorphicCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/weather_space_2"
                android:baselineAligned="false"
                android:clipChildren="false"
                android:orientation="horizontal">

                <!-- Карточка: Вероятность осадков -->
                <com.protonmail.jobforandroid.weather.widgets.NeomorphicCardView
                    android:id="@+id/cardPrecipitation"
                    style="@style/Widget.Weather.Card.Forecast"
                    app:neomorphicFaceOpacity="0.25"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/weather_space_1"
                    android:layout_marginStart="-4dp"
                    android:layout_weight="1"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Weather.Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:minHeight="125dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:contentDescription="@null"
                            app:tint="?attr/colorPrimary"
                            app:srcCompat="@drawable/ic_weather_precipitation" />

                        <TextView
                            style="@style/TextAppearance.Weather.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="@string/weather_precipitation"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/tvPrecipitationValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/inter_semibold"
                            android:gravity="center"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="22sp"
                            tools:text="40%" />
                    </LinearLayout>
                </com.protonmail.jobforandroid.weather.widgets.NeomorphicCardView>

                <!-- Карточка: Давление -->
                <com.protonmail.jobforandroid.weather.widgets.NeomorphicCardView
                    android:id="@+id/cardPressure"
                    style="@style/Widget.Weather.Card.Forecast"
                    app:neomorphicFaceOpacity="0.25"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/weather_space_1"
                    android:layout_marginEnd="-4dp"
                    android:layout_weight="1"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Weather.Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:minHeight="125dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:contentDescription="@null"
                            app:tint="?attr/colorPrimary"
                            app:srcCompat="@drawable/ic_weather_pressure" />

                        <TextView
                            style="@style/TextAppearance.Weather.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="@string/weather_pressure"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/tvPressureValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/inter_semibold"
                            android:gravity="center"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="20sp"
                            tools:text="1013 гПа" />
                    </LinearLayout>
                </com.protonmail.jobforandroid.weather.widgets.NeomorphicCardView>
            </LinearLayout>

            <!-- Карточка восхода и заката -->
            <com.protonmail.jobforandroid.weather.widgets.NeomorphicCardView
                android:id="@+id/linearLayout"
                style="@style/Widget.Weather.Card.Forecast"
                app:neomorphicFaceOpacity="0.25"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/weather_space_3"
                android:layout_marginStart="-4dp"
                android:layout_marginEnd="-4dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Weather.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <!-- Колонка: Восход -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingEnd="8dp"
                        android:paddingStart="0dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/im_sunrise"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center_vertical"
                            android:contentDescription="@null"
                            app:tint="?attr/colorPrimary"
                            app:srcCompat="@drawable/ic_sunrise" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:text="@string/sunrise"
                                android:textAppearance="@style/TextAppearance.Weather.Body"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                            <TextView
                                android:id="@+id/tv_sunrise"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/inter_semibold"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="18sp"
                                tools:text="06:24 AM" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Колонка: Закат -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingEnd="0dp"
                        android:paddingStart="8dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/im_sunset"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center_vertical"
                            android:contentDescription="@null"
                            app:tint="?attr/colorPrimary"
                            app:srcCompat="@drawable/ic_sunset" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:text="@string/sunset"
                                android:textAppearance="@style/TextAppearance.Weather.Body"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                            <TextView
                                android:id="@+id/tv_sunset"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/inter_semibold"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="18sp"
                                tools:text="07:42 PM" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.protonmail.jobforandroid.weather.widgets.NeomorphicCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
