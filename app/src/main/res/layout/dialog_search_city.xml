<?xml version="1.0" encoding="utf-8"?>
<com.protonmail.jobforandroid.weather.widgets.NeomorphicCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Weather.Card.Forecast"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:shapeAppearanceOverlay="@style/ShapeAppearance.Weather.Card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dialog_city_name"
            android:textAppearance="@style/TextAppearance.Weather.City"
            android:textSize="20sp"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Weather.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint=""
            app:boxBackgroundColor="?attr/colorSurfaceVariant"
            app:boxStrokeColor="@color/weather_accent"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="2dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Weather.Control"
            app:startIconDrawable="@drawable/ic_city_search"
            app:startIconTint="?attr/colorPrimary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edCityName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/search_city_hint"
                android:maxLines="1"
                android:minHeight="56dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:inputType="text"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_cancel"
                android:textColor="?attr/colorPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOk"
                style="@style/Widget.Weather.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/action_ok"
                app:iconTint="?attr/colorPrimary" />
        </LinearLayout>
    </LinearLayout>
</com.protonmail.jobforandroid.weather.widgets.NeomorphicCardView>
